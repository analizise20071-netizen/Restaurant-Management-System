<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600" prefWidth="900" stylesheets="@css/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.restaurant.controller.MenuController">

    <top>
        <HBox spacing="15" style="-fx-padding: 15; -fx-background-color: #2c3e50;">
            <Label style="-fx-text-fill: white;" styleClass="title-label" text="Menu &amp; Order Management" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleAsyncRefresh" styleClass="button-primary" text="Async Refresh Menu" />
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.55">
            <!-- Left Side: Menu Items & Filter -->
            <VBox spacing="10" style="-fx-padding: 10;">
                <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Browse Menu" />
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Category:" />
                    <ComboBox fx:id="categoryComboBox" onAction="#handleCategoryChange" prefWidth="180" promptText="All Categories" />
                </HBox>
            <ScrollBar orientation="VERTICAL" />

                <ListView fx:id="menuListView" VBox.vgrow="ALWAYS" />

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Qty:" />
                    <Spinner fx:id="quantitySpinner" prefWidth="70" />
                    <TextField fx:id="notesField" promptText="Notes (e.g., No onions)" HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleAddToOrder" styleClass="button-primary" text="Add to Order" />
                </HBox>
            </VBox>

            <!-- Right Side: Active Order Cart & Running Total -->
            <VBox spacing="10" style="-fx-padding: 10;">
                <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Current Order Cart" />

                <TableView fx:id="orderTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colItemName" prefWidth="120" text="Item" />
                        <TableColumn fx:id="colQty" prefWidth="50" text="Qty" />
                        <TableColumn fx:id="colUnitPrice" prefWidth="80" text="Unit Price" />
                        <TableColumn fx:id="colTotal" prefWidth="80" text="Total" />
                        <TableColumn fx:id="colNotes" prefWidth="100" text="Notes" />
                    </columns>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Running Total:" />
                    <Label fx:id="runningTotalLabel" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #27ae60;" text="0.00 EGP" />
                </HBox>

                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button onAction="#handleClearOrder" text="Clear Order" />
                    <Button onAction="#handleSubmitOrder" styleClass="button-primary" text="Submit Order" />
                </HBox>

                <!-- Admin CRUD Panel -->
                <TitledPane expanded="false" text="Admin / Waiter Controls">
                    <VBox spacing="8">
                        <TextField fx:id="newItemName" promptText="Item Name" />
                        <TextField fx:id="newItemPrice" promptText="Price" />
                        <TextField fx:id="newItemDesc" promptText="Description" />
                        <CheckBox fx:id="newItemAvailable" selected="true" text="Available" />
                        <Button maxWidth="Infinity" onAction="#handleAdminAddItem" text="Add New Item (Admin CRUD)" />
                    </VBox>
                </TitledPane>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
